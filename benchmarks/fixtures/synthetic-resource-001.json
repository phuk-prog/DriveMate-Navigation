  "sizes": [
    8,
    16,
    32
  ],
  "configurations": [
    "Dijkstra",
    "A*-raw",
    "A*-prepared"
  ],
  "timed_repetitions": 10,
  "warmup_repetitions": 1,
  "memory_repetitions": 1,
  "worker_timeout_s": 40,
  "total_timeout_s": 180,
  "cases": [
    {
