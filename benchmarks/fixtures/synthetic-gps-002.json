      "id": "GPS-002-parallel-first",
      "category": "ambiguity",
      "events": [
        {
          "fix": [
            1000,
            2.25e-05,
            0.0002,
            3,
            10,
            90
          ],
          "expected_status": "AMBIGUOUS",
          "justification": "Equal fit to two disconnected parallel ways; no fresh identifying history"
        }
      ],
      "oracle_rationale": "A point equidistant from the two eastbound roads cannot identify one."
    },
