      "expected_length_m": 1568,
      "expected_seconds": 141.12
    },
    {
      "id": "RESOURCE-001-8-reverse",
      "size": 8,
      "source": "v-7-7",
      "destination": "v-0-0",
      "expected_edges": 14,
      "expected_length_m": 1568,
      "expected_seconds": 141.12
    },
    {
      "id": "RESOURCE-001-8-row",
      "size": 8,
      "source": "v-4-0",
      "destination": "v-4-7",
      "expected_edges": 7,
      "expected_length_m": 784,
      "expected_seconds": 70.56
    },
    {
