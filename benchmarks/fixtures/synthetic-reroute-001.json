        {
          "action": "observe",
          "timestamp_ms": 1000,
          "now_ms": 1000,
          "on_route": false,
          "reliable": true,
          "expect_request": null
        },
        {
          "action": "observe",
          "timestamp_ms": 2000,
          "now_ms": 2000,
          "on_route": false,
          "reliable": true,
          "expect_request": "a"
        },
        {
          "action": "complete",
          "token": "a",
          "now_ms": 2500,
          "planner": "detour",
          "expect_accepted": true,
          "expect_route": "detour"
        }
      ]
    },
