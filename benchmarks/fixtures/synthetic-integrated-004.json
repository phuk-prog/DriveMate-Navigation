      "expected_installed_route": true
    },
    {
      "id": "INTEGRATED-004-explicit-stop-fallback",
      "update_variant": "B",
      "explicit_stop_after_update": true,
      "expected_controller_active": false,
      "expected_installed_route": false
    }
  ]
