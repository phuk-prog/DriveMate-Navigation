        },
        {
          "action": "route",
          "source": "osm:1",
          "target": "osm:3",
          "expect_status": "ROUTE",
          "expect_edges": [
            "w:10:0:f",
            "w:30:0:f",
            "w:40:0:f",
            "w:50:0:f"
          ]
